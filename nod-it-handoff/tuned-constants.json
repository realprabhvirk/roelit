{
  "_about": "Every tuned value in ROEL IT! v1.4.1 (commit 97e4e92), pulled from the code. 'src' = file in the ROEL IT! repo (copies in reference-src/). Ship these unless a test proves a better value; log any change in DECISIONS.md.",
  "settingsDefaults": {
    "_src": "src/state.ts",
    "roundLength": 60,
    "roundLengths": [30, 60, 90, 120],
    "sensitivity": "medium",
    "voice": true,
    "voiceLang": "en-AU",
    "voiceLangs": ["en-AU", "en-GB", "en-US"],
    "sound": true,
    "haptics": true,
    "flipTilt": false,
    "theme": "system",
    "record": false,
    "flipVideo": false
  },
  "tilt": {
    "_src": "src/tilt.ts",
    "thresholdDegBySensitivity": { "low": 45, "medium": 38, "high": 30 },
    "neutralBandDeg": 18,
    "lockoutMs": 700,
    "holdPastThresholdMs": 60,
    "lowPassTauMs": { "deviceorientation": 60, "devicemotion": 110 },
    "lowPassDtClampMs": 200,
    "preferOrientationIfSeenWithinMs": 400,
    "motionSteadyGRange": [0.75, 1.25],
    "uprightWhenAbsDownX": 0.8,
    "followSideBeforeCalibrationWhenAbsDownX": 0.5,
    "baselineClampDeg": 25,
    "calibration": "average the filtered down-vector over the whole 3-2-1 countdown; side = sign(down.x) of that average; baseline pitch clamped to ±25°",
    "pitchFormula": "pitch = atan2(down.z, side * down.x) in degrees; + = screen towards floor = correct; - = towards ceiling = pass",
    "downVectorFromOrientation": "down = (sin γ·cos β, −sin β, −cos β·cos γ)",
    "downVectorFromMotion": "iOS: down = normalise(accelerationIncludingGravity); others: down = −normalise(accelerationIncludingGravity)",
    "detectorStartsDisarmed": true,
    "rearmRequires": "|pitch| <= neutralBandDeg AND lockout elapsed"
  },
  "autoStart": {
    "_src": "src/ui/PreRound.tsx",
    "openGraceMs": 2500,
    "tapPausesForMs": 3000,
    "tapAlsoDisarms": true,
    "armsAfterFirstNonUprightSample": true,
    "holdUprightMs": 1000,
    "showProgressBar": true,
    "waitForCameraIfRecording": true
  },
  "round": {
    "_src": "src/game.ts, src/ui/RoundScreen.tsx",
    "countdownFrom": 3,
    "countdownStepMs": 1000,
    "flashMs": 650,
    "engineTickMs": 50,
    "hurryLastSeconds": 10,
    "tickSoundEachSecondWhenLeftAtMost": 10,
    "timeUpScreenMs": 1400,
    "endedEarlyScreenMs": 700,
    "timerKeepsRunningDuringFlash": true,
    "portraitPausesClock": true,
    "endConfirmPausesClock": true,
    "earlyEndCountsTowardsBest": false,
    "earlyEndWithNothingPlayedAndNoRecording": "go straight back to tabs",
    "newBestShownOnlyIfPreviousBestAbove": 0
  },
  "cardQueue": {
    "_src": "src/game.ts",
    "shuffle": "Fisher-Yates",
    "noRepeatUntilExhausted": true,
    "persistRemainingOrderPerDeck": "localStorage key queue:<deckId>",
    "avoidSameCardAcrossReshuffle": true
  },
  "voice": {
    "_src": "src/voice.ts",
    "continuous": true,
    "interimResults": true,
    "maxAlternatives": 3,
    "maxWordsConsidered": 12,
    "debounceAfterCardChangeMs": 800,
    "restartBackoffMs": { "base": 250, "doubleWhenSessionShorterThanMs": 1000, "max": 4000, "networkErrorMin": 2000 },
    "giveUpAfterInstantDeaths": 4,
    "startConfirmTimeoutMs": 5000,
    "waitForPreviousRecogniserMs": 1500,
    "standaloneAutoRestartOnlyIf": "navigator.permissions mic state 'granted' OR last start reached onstart in < 800 ms",
    "notAllowedOnFirstStart": "blocked for this session (not persisted)",
    "notAllowedAfterItWorked": "paused (tap-to-resume pill)",
    "audioCapture": "paused"
  },
  "match": {
    "_src": "src/match.ts",
    "levenshteinMaxEdits": 1,
    "fuzzyIfTargetLengthAtLeast": 5,
    "fuzzyIfHeardLengthAtLeast": 4,
    "exactOnlyIfTargetLengthAtMost": 2,
    "numbersExactOnly": true,
    "multiWordWindowWords": "max(6, tokens + 3)",
    "joinSplitCompoundsUpToTokens": 3,
    "optionalWords": ["the", "a", "an", "and", "of"],
    "fold": { "street": "st", "saint": "st", "road": "rd", "crescent": "cr", "cres": "cr", "avenue": "ave", "av": "ave", "mount": "mt", "doctor": "dr", "mister": "mr", "drive": "dr", "okay": "ok", "vs": "versus", "&": "and", "n": "and" },
    "stemmer": "ies→y; (ches|shes|xes|sses|zes)→drop 'es'; trailing s (not ss); -ing (len>5); -ed (len>4); undouble final bdgmnprt",
    "numberWords": "zero..nineteen, twenty..ninety, hundred, 'a hundred', 'and' after hundred; adjacent digit tokens also tried merged (1 80 → 180)",
    "lookupsMustBeOwnProperty": true
  },
  "wordFit": {
    "_src": "src/ui/fit.ts",
    "lineHeight": 0.95,
    "maxLines": 3,
    "usableWidthFraction": 0.93,
    "binarySearchIterations": 18,
    "balanceIterations": 14,
    "neverBreakInsideAWord": true
  },
  "sheet": {
    "_src": "src/ui/controls.tsx, src/styles.css",
    "openCloseTransitionMs": 420,
    "unmountAfterCloseMs": 420,
    "dragDismissIfDraggedFractionOfHeight": 0.3,
    "dragDismissIfDraggedPxAndVelocity": { "px": 40, "pxPerMs": 0.6 },
    "rubberBandUp": "-sqrt(-dy) * 2",
    "closedRootPointerEvents": "none",
    "largeTitleCollapseScrollPx": 36
  },
  "motion": {
    "_src": "src/styles.css",
    "ease": "cubic-bezier(0.2, 0.8, 0.2, 1)",
    "easeOut": "cubic-bezier(0.16, 1, 0.3, 1)",
    "pressReleaseMs": 260,
    "pressScale": 0.97,
    "pressOpacity": 0.86,
    "tabFadeMs": 200,
    "fullscreenRiseMs": 280,
    "countdownPopMs": 900,
    "timerPulsePeriodMs": 1000,
    "wordEnterMs": 260,
    "flashInMs": 160,
    "timeUpPopMs": 700,
    "switchMs": 280,
    "segmentedThumbMs": 280,
    "passcodeShakeMs": 420,
    "reducedMotion": "all animations/transitions → 1ms"
  },
  "sounds": {
    "_src": "src/audio.ts (Web Audio, no files)",
    "correct": "triangle 784 Hz 0.12 s + triangle 1175 Hz at +0.085 s 0.2 s (gain 0.32) + sine 392 Hz at +0.085 s 0.18 s (gain 0.12)",
    "pass": "sine 190→70 Hz 0.22 s gain 0.55 attack 4 ms + triangle 120→60 Hz 0.12 s gain 0.18",
    "countdown": "sine 660 Hz 0.12 s gain 0.3",
    "go": "sine 990 Hz 0.28 s gain 0.32",
    "tick": "triangle 1600 Hz 0.045 s gain 0.16 attack 2 ms",
    "buzzer": "two sawtooths 146 + 151 Hz through low-pass 1100 Hz, 0.8 s, gain 0.22",
    "masterGain": 0.9,
    "audioSession": "never touch navigator.audioSession"
  },
  "haptics": {
    "_src": "src/haptics.ts",
    "androidVibratePatternsMs": { "select": 6, "light": 10, "medium": 18, "success": [12, 70, 22], "error": [24, 50, 24, 50, 24], "correct(nod)": [14, 55, 14], "pass": [45] },
    "iosSwitchTicks": { "select": 1, "light": 1, "medium": 1, "success": 2, "error": 3, "correct(nod)": 2, "pass": 1 },
    "iosTickSpacingMs": 75,
    "iosNote": "iOS ticks only inside a real tap; reportedly from iOS 26.5 only the first tick of a pattern plays and only from a real tap on a switch"
  },
  "recording": {
    "_src": "src/recorder.ts, src/camera.ts, src/videoOrientation.ts",
    "cameraConstraints": { "facingMode": "user", "width": 1280, "height": 720, "frameRate": 30, "audio": true },
    "canvas": [1280, 720],
    "captureFps": 30,
    "videoBitsPerSecond": 3000000,
    "audioBitsPerSecond": 128000,
    "timesliceMs": 1000,
    "mimePreference": ["video/mp4;codecs=avc1.42E01E,mp4a.40.2", "video/mp4;codecs=avc1", "video/mp4", "video/webm;codecs=vp9,opus", "video/webm;codecs=vp8,opus", "video/webm"],
    "overlay": { "marginPx": 32, "bottomBandPx": 176, "chipHeightPx": 64, "chipRadiusPx": 14, "progressStripPx": 8, "wordMaxLines": 2, "wordMaxSizePx": 120 },
    "endCardHoldMs": "end screen ms + 900",
    "frameModeLearnAfterConsistentReadings": 20,
    "previewPollMs": 100,
    "rotationRules": { "follows": "0", "landscapeRaw": "angle 270 → 180, else 0", "portraitRaw": "angle 270 → 90, else 270", "flipVideo": "+180" },
    "voiceDuringRecording": "off",
    "previewMirrored": true,
    "recordingMirrored": false
  },
  "passcodeVault": {
    "_src": "src/vault-crypto.ts, src/vault.ts, src/ui/Passcode.tsx",
    "kdf": "PBKDF2-SHA256",
    "iterations": 600000,
    "saltBytes": 16,
    "ivBytes": 12,
    "cipher": "AES-GCM 256",
    "keypadLengthFrom": "codeLength field in the locked deck file",
    "checkTimeoutMs": 10000,
    "wrongShakeMs": 420,
    "keysActOn": "pointerdown (click only for keyboard, detail === 0)",
    "rememberCodeOnDevice": true
  },
  "diagnostics": {
    "_src": "src/debug.ts",
    "maxLines": 400,
    "persistDebounceMs": 800,
    "stallHeartbeatMs": 500,
    "stallReportIfLateMs": 1200,
    "noClickReportAfterMs": 700,
    "keepsPreviousSession": true
  },
  "pwa": {
    "_src": "vite.config.ts, src/main.tsx, src/index.html",
    "registerType": "prompt",
    "updateCheck": "on every visibilitychange to visible (online) + every 30 min",
    "statusBarStyle": "default",
    "themeColorPerScreen": true,
    "manifest": { "id": "./", "start_url": "./", "scope": "./", "display": "standalone", "orientation": "any", "lang": "en-AU" }
  },
  "layout": {
    "_src": "src/ui/PlayTab.tsx, src/styles.css",
    "deckTileHeightsPx": [212, 156, 184, 232, 164, 200, 148, 220],
    "deckGridColumns": { "portrait": 2, "landscapeWiderThan700": 4 },
    "tabBarHeightPx": 50,
    "tabBarHeightShortLandscapePx": 44,
    "minTapTargetPt": 44,
    "pageGutterPx": 16,
    "roundTapZoneWidthFraction": 0.24
  },
  "onColorRule": {
    "_src": "src/palette.ts",
    "rule": "relative luminance L > 0.33 → dark text, else light text"
  }
}
